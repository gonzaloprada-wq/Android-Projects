<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainMenuActivity">

    <TextView
        android:id="@+id/textoBienvenida2"
        android:layout_width="356dp"
        android:layout_height="122dp"
        android:text="¡Bienvenido, error_nombre !"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.237" />

    <EditText
        android:id="@+id/ingresado"
        android:layout_width="283dp"
        android:layout_height="86dp"
        android:ems="10"
        android:hint="User name"
        android:inputType="text"
        android:textColor="#646464"
        android:textColorHint="#767474"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.468"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.408" />

    <Button
        android:id="@+id/buttonNavegador"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#D7222A"
        android:elevation="29dp"
        android:shadowColor="#5F5C5C"
        android:shadowRadius="12"
        android:text="Navegador"
        android:textColor="#FFFFFF"
        android:textColorLink="#D7222A"
        android:textStyle="bold"
        android:translationZ="8dp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.17"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.562"
        app:layout_marginBaseline="16dp"
        app:strokeColor="#FFFFFF" />

    <Button
        android:id="@+id/buttonTelefono"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#D7222A"
        android:elevation="29dp"
        android:shadowColor="#5F5C5C"
        android:shadowRadius="12"
        android:text="Telefono"
        android:textColor="#FFFFFF"
        android:textColorLink="#D7222A"
        android:textStyle="bold"
        android:translationZ="8dp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.771"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.559"
        app:layout_marginBaseline="16dp"
        app:strokeColor="#FFFFFF" />

    <Button
        android:id="@+id/buttonCompartir"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#D7222A"
        android:elevation="29dp"
        android:shadowColor="#5F5C5C"
        android:shadowRadius="12"
        android:text="Compartir"
        android:textColor="#FFFFFF"
        android:textColorLink="#D7222A"
        android:textStyle="bold"
        android:translationZ="8dp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.811"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.709"
        app:layout_marginBaseline="16dp"
        app:strokeColor="#FFFFFF" />

    <Button
        android:id="@+id/Volver"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#D7222A"
        android:elevation="29dp"
        android:shadowColor="#5F5C5C"
        android:shadowRadius="12"
        android:text="Volver"
        android:textColor="#FFFFFF"
        android:textColorLink="#D7222A"
        android:textStyle="bold"
        android:translationZ="8dp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.813"
        app:layout_marginBaseline="16dp"
        app:strokeColor="#FFFFFF" />

    <Button
        android:id="@+id/buttonMensaje"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="#D7222A"
        android:elevation="29dp"
        android:shadowColor="#5F5C5C"
        android:shadowRadius="12"
        android:text="Mensaje"
        android:textColor="#FFFFFF"
        android:textColorLink="#D7222A"
        android:textStyle="bold"
        android:translationZ="8dp"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.178"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.708"
        app:layout_marginBaseline="16dp"
        app:strokeColor="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>
